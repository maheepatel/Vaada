# Copy to .env.local and fill in from your Supabase project settings.
#
# Without these the app still runs: it reads the founding register from
# src/data/seed.ts and validates submissions without storing them.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Never prefix this with NEXT_PUBLIC_. Needed for scripts/seed.ts
# and for any moderation tooling, because RLS forbids the anon key from writing
# to `commitments` or from changing a verdict.
SUPABASE_SERVICE_ROLE_KEY=

# Public base URL. Used in the links inside alert emails, so it must be the real
# deployed origin or the notices point at localhost.
NEXT_PUBLIC_SITE_URL=

# ---------------------------------------------------------------- cron ----
# Protects /api/cron/*. Vercel Cron sends it automatically as a Bearer token.
# Without it, the cron routes are open in development and CLOSED in production.
CRON_SECRET=

# Opens /review, which shows unreviewed machine output naming real officials.
# Until this is set, the queue stays shut.
REVIEW_TOKEN=

# -------------------------------------------------------------- alerts ----
# READ THIS BEFORE SETTING ANY OF IT.
#
# These switches cause email to be sent to real people, in your name, without a
# human seeing each message first. Everything is off by default and the sweep
# runs indefinitely as a dry run, recording exactly what it *would* send. Read
# a few runs of that before turning anything on.
#
# GET /api/cron/alerts?preview=1 shows the composed notices and sends nothing,
# whatever these are set to.

# Master switch. Without 'true' nothing is ever transmitted.
ALERTS_ENABLED=false

# Separate switch for notices to government officials, kept apart on purpose:
# mailing the people who follow a promise is harmless, writing to a minister is
# not, and the two must never share a flag.
ALERTS_NOTIFY_AUTHORITIES=false

ALERTS_FROM=
ALERTS_FROM_NAME=
ALERTS_REPLY_TO=

# Mail provider. Without a key, sends are skipped and recorded as dry runs.
RESEND_API_KEY=

# ------------------------------------------------------------- ingest ----
# X/Twitter is authenticated; anonymous fetches return 402. The X source stays
# disabled until a token is present. News RSS ingestion needs no key.
X_BEARER_TOKEN=
